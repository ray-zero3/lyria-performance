# 観客リクエストアプリのサーバ専用設定（この .env は git 無視される）。
# コピーして使う: cp .env.example .env
#
# OpenCode Go の API キー（サーバ側でのみ使用。クライアントには絶対に露出しない）。
# 取得: https://opencode.ai/zen にサインイン → Go プランのワークスペースでキー発行。
# 注意: 鍵はワークスペース単位。Go のクレジットがあるワークスペースの鍵を使うこと。
NUXT_OPENCODE_API_KEY=

# 使用モデル（任意。未指定は hy3）。
# 実測（2026-07-25・本番同一条件 n=20）で hy3 が最安定: JSON 20/20・p50 2.1s・出力13tok・思考しない。
# 避けるべき: glm-5.2(3/5) / glm-5.1(9/20) / deepseek-v4-flash・minimax-m2.5・mimo-v2.5(0/5＝思考で
# content が空) / kimi-k2.5(JSON 出さない) / qwen3.7-plus・qwen3.6-plus(16〜27s で実用外)。
# hy3-preview は Go プラン未対応（400）。無料の laguna-s-2.1-free 等は Go の /models 一覧に無い。
# NUXT_OPENCODE_MODEL=hy3

# ベース URL（任意）。Go のクレジットが乗るのは /zen/go/v1（pay-as-you-go の /zen/v1 とは別）。
# NUXT_OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# 公開面のアクセスキー（Funnel/トンネルで公開するなら実質必須）。
# ?k=<この値> を持つリクエストだけ通し、以降は Cookie で省略できる（未設定ならこの防御は無効）。
# 背景: Funnel は TLS 証明書を発行するのでホスト名が CT log に載り、公開から数分で
# /.env /.env.production /config を探す自動スキャナが来る（実測）。URL の秘匿は成立しないため、
# キーで入口を絞る。VJ 画面の QR には ?k= 付き URL を載せる（ルート .env の VITE_REQUEST_URL）。
# 生成例: openssl rand -hex 12
NUXT_ACCESS_KEY=

# cue API（GET /api/cue, POST /api/cue/consume）の共有トークン【必須】。
# Tailscale Funnel は localhost:3000 を丸ごと公開するため、パスで cue API を隠せない。
# 未設定だと cue API は 503（fail-closed）＝リクエスト機能が無効になる。
# ルート .env の VITE_CUE_TOKEN と「同一の値」にする。生成例: openssl rand -hex 32
NUXT_CUE_TOKEN=
