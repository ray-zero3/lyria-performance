# Lyria RealTime API キー設定テンプレ.
# これをコピーして `.env` を作り、自分の環境で値を入れる（.env は git 無視される）。
#   cp .env.example .env
#
# --- ブラウザ dev（npm run dev）で Lyria を使う場合 ---
# VITE_ プレフィックスの変数は frontend（import.meta.env）に露出する。
# 注意: この値はビルド後のJSに含まれる＝ローカル/個人利用向け。配布物には使わない。
VITE_GEMINI_API_KEY=

# --- Tauri（npm run tauri dev）で Lyria を使う場合 ---
# Rust が process env の GEMINI_API_KEY を読む（.env は自動ロードされない）。
# 起動時にコマンド前置きで渡す:
#   GEMINI_API_KEY=あなたのキー npm run tauri dev

# --- VJ 画面に出す観客リクエストページの URL（QR コードになる） ---
# Tailscale Funnel で公開したときのアドレス。未設定なら既定の
# https://<このマシン>.<tailnet>.ts.net/ が使われる。
# 確認: /Applications/Tailscale.app/Contents/MacOS/Tailscale status --json | grep DNSName
#
# アクセスキーを使う場合は ?k=<キー> を必ず含める（request-app/.env の NUXT_ACCESS_KEY と同一値）。
# 例: VITE_REQUEST_URL=https://xxxx.tailnet.ts.net/?k=0123456789abcdef01234567
VITE_REQUEST_URL=

# --- 観客リクエスト機能（request-app）の cue API を叩くための共有トークン ---
# request-app/.env の NUXT_CUE_TOKEN と「同一の値」にする（不一致だと cue が 401 で無効化）。
# 生成例: openssl rand -hex 32
# control/VJ 窓はローカル専用・配布物ではないため VITE_ で持たせている。
VITE_CUE_TOKEN=
