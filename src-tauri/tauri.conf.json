{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lyria-vj",
  "version": "0.1.0",
  "identifier": "com.rei.lyriavj",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "lyria-vj control",
        "url": "/",
        "width": 1360,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720
      },
      {
        "label": "vj",
        "title": "lyria-vj VJ",
        "url": "/vj",
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
